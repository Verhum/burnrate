# burnrate environment variables
# Config precedence: hardcoded defaults -> DB settings (web UI) -> env vars
# Account keys use inverted precedence: DB wins over env.

# --- Server ---

# HTTP server port
BURNRATE_PORT=9112

# Data directory (DB, logs, worktrees, agentwork, attachments)
BURNRATE_DATA_DIR=~/.burnrate

# Stub claude invocations (set to "1" or "true" to enable)
BURNRATE_DRYRUN=false

# --- Scheduler ---

# Max concurrent claude runs
BURNRATE_PARALLEL_N=3

# 5-hour utilization % cap (100 = disabled, no gating)
BURNRATE_UTIL_THRESHOLD=100

# 7-day utilization % backoff threshold
BURNRATE_SEVENDAY_THRESHOLD=95

# Scheduler poll interval in seconds
BURNRATE_POLL_INTERVAL_SEC=180

# Minimum time remaining in window (minutes) to launch a new task
BURNRATE_MIN_LAUNCH_WINDOW_MIN=20

# Minutes subtracted from timeout before window end
BURNRATE_DRAIN_MARGIN_MIN=10

# Max run attempts per task before marking failed
BURNRATE_MAX_ATTEMPTS=5

# --- Runner ---

# Claude model to use
BURNRATE_MODEL=claude-opus-4-6

# Base code folder holding the repo checkouts agents work in
BURNRATE_BASE_CODE_DIR=~/code

# Root directory for git worktrees
BURNRATE_WORKTREE_ROOT=~/.burnrate/worktrees

# --- Usage API ---

# Anthropic usage API endpoint
BURNRATE_USAGE_URL=https://api.anthropic.com/api/oauth/usage

# --- Account / Auth ---
# These use inverted precedence: a DB selection (via web UI) wins over env.

# Pinned Claude Code config directory (selects which account to use)
# BURNRATE_CLAUDE_CONFIG_DIR=

# Path to sandbox keychain (auto-derived from config dir if empty)
# BURNRATE_SANDBOX_KEYCHAIN=

# Path to keychain password file (auto-derived from config dir if empty)
# BURNRATE_SANDBOX_KEYCHAIN_PASSWORD_FILE=
