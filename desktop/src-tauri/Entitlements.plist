<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the main app bundle (Developer ID +
  notarization, NOT App Store, so NO app sandbox).

  Outbound network for the webview (localhost UI) and sidecar (API calls).
-->
<plist version="1.0">
<dict>
    <!-- Allow loading the bundled Go sidecar binary. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound network for the webview and sidecar. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
